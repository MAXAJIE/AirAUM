diff --git a/src/lib/amenities.server.ts b/src/lib/amenities.server.ts
new file mode 100644
index 0000000..f9b930f
--- /dev/null
+++ b/src/lib/amenities.server.ts
@@ -0,0 +1,74 @@
+import { supabaseAdmin } from "@/integrations/supabase/client.server";
+
+/**
+ * Keeps every place that follows a supply template in step with it.
+ *
+ * A place's supply line remembers the template line it came from. Renaming or
+ * re-ordering a template line updates the linked lines everywhere; the expected
+ * quantity is only pushed down when the place has not set its own figure
+ * (`qty_overridden`).
+ */
+export async function syncTemplateToProperties(orgId: string, templateId: string) {
+  const [{ data: items }, { data: properties }] = await Promise.all([
+    supabaseAdmin
+      .from("amenity_template_items")
+      .select("id, name, expected_qty, unit, sort_order")
+      .eq("template_id", templateId)
+      .order("sort_order"),
+    supabaseAdmin
+      .from("properties")
+      .select("id")
+      .eq("org_id", orgId)
+      .eq("amenity_template_id", templateId),
+  ]);
+
+  const lines = items ?? [];
+  const lineIds = lines.map((i) => i.id);
+
+  for (const property of properties ?? []) {
+    const { data: existing } = await supabaseAdmin
+      .from("amenity_definitions")
+      .select("id, template_item_id, qty_overridden")
+      .eq("property_id", property.id)
+      .eq("template_id", templateId);
+
+    const byLine = new Map(
+      (existing ?? []).filter((e) => e.template_item_id).map((e) => [e.template_item_id!, e]),
+    );
+
+    for (const line of lines) {
+      const match = byLine.get(line.id);
+      if (match) {
+        await supabaseAdmin
+          .from("amenity_definitions")
+          .update({
+            name: line.name,
+            unit: line.unit,
+            sort_order: line.sort_order,
+            active: true,
+            ...(match.qty_overridden ? {} : { expected_qty: line.expected_qty }),
+          })
+          .eq("id", match.id);
+      } else {
+        await supabaseAdmin.from("amenity_definitions").insert({
+          org_id: orgId,
+          property_id: property.id,
+          template_id: templateId,
+          template_item_id: line.id,
+          name: line.name,
+          expected_qty: line.expected_qty,
+          unit: line.unit,
+          sort_order: line.sort_order,
+        });
+      }
+    }
+
+    // Lines removed from the template disappear from the linked places too.
+    const stale = (existing ?? []).filter(
+      (e) => !e.template_item_id || !lineIds.includes(e.template_item_id),
+    );
+    for (const row of stale) {
+      await supabaseAdmin.from("amenity_definitions").delete().eq("id", row.id);
+    }
+  }
+}
diff --git a/src/lib/checklists.functions.ts b/src/lib/checklists.functions.ts
new file mode 100644
index 0000000..d6e6c71
--- /dev/null
+++ b/src/lib/checklists.functions.ts
@@ -0,0 +1,209 @@
+import { createServerFn } from "@tanstack/react-start";
+import { requireSupabaseAuth } from "@/integrations/supabase/auth-middleware";
+import { z } from "zod";
+
+/**
+ * Cleaning checklist templates.
+ *
+ * A workspace keeps shared templates (no property). Any single place may
+ * override a template for one job type; the override wins when a job is
+ * created. See `resolveChecklistId` in ops.server.ts.
+ */
+
+const TASK_TYPES = ["turnover_clean", "deep_clean", "inspection", "maintenance", "restock"] as const;
+
+export type ChecklistItemRow = {
+  id: string;
+  label: string;
+  room: string;
+  requiresPhoto: boolean;
+  position: number;
+};
+
+export type ChecklistRow = {
+  id: string;
+  name: string;
+  taskType: (typeof TASK_TYPES)[number];
+  propertyId: string | null;
+  propertyName: string | null;
+  isDefault: boolean;
+  isActive: boolean;
+  items: ChecklistItemRow[];
+};
+
+export const listChecklists = createServerFn({ method: "POST" })
+  .middleware([requireSupabaseAuth])
+  .inputValidator((d: unknown) => z.object({ orgId: z.string().uuid() }).parse(d))
+  .handler(async ({ data, context }): Promise<ChecklistRow[]> => {
+    const { requireMembership, supabaseAdmin, STAFF_ROLES } = await import("./ops.server");
+    await requireMembership(context.userId, data.orgId, STAFF_ROLES);
+
+    const [{ data: lists }, { data: items }, { data: properties }] = await Promise.all([
+      supabaseAdmin
+        .from("checklists")
+        .select("id, name, task_type, property_id, is_default, is_active")
+        .eq("org_id", data.orgId)
+        .order("name"),
+      supabaseAdmin
+        .from("checklist_items")
+        .select("id, checklist_id, label, room, requires_photo, position")
+        .eq("org_id", data.orgId)
+        .order("position"),
+      supabaseAdmin.from("properties").select("id, name").eq("org_id", data.orgId),
+    ]);
+
+    const names = new Map((properties ?? []).map((p) => [p.id, p.name]));
+    return (lists ?? []).map((l) => ({
+      id: l.id,
+      name: l.name,
+      taskType: l.task_type,
+      propertyId: l.property_id,
+      propertyName: l.property_id ? (names.get(l.property_id) ?? null) : null,
+      isDefault: l.is_default,
+      isActive: l.is_active,
+      items: (items ?? [])
+        .filter((i) => i.checklist_id === l.id)
+        .map((i) => ({
+          id: i.id,
+          label: i.label,
+          room: i.room,
+          requiresPhoto: i.requires_photo,
+          position: i.position,
+        })),
+    }));
+  });
+
+const checklistInput = z.object({
+  orgId: z.string().uuid(),
+  id: z.string().uuid().optional(),
+  name: z.string().trim().min(1).max(120),
+  taskType: z.enum(TASK_TYPES),
+  propertyId: z.string().uuid().nullable().default(null),
+  isDefault: z.boolean().default(false),
+  isActive: z.boolean().default(true),
+  items: z
+    .array(
+      z.object({
+        label: z.string().trim().min(1).max(200),
+        room: z.string().trim().max(60).default("General"),
+        requiresPhoto: z.boolean().default(false),
+      }),
+    )
+    .max(200),
+});
+
+export const saveChecklist = createServerFn({ method: "POST" })
+  .middleware([requireSupabaseAuth])
+  .inputValidator((d: unknown) => checklistInput.parse(d))
+  .handler(async ({ data, context }) => {
+    const { requireMembership, supabaseAdmin, ADMIN_ROLES, logAudit } = await import("./ops.server");
+    await requireMembership(context.userId, data.orgId, ADMIN_ROLES);
+
+    // A place can only carry one override per job type.
+    if (data.propertyId) {
+      const { data: clash } = await supabaseAdmin
+        .from("checklists")
+        .select("id")
+        .eq("org_id", data.orgId)
+        .eq("property_id", data.propertyId)
+        .eq("task_type", data.taskType)
+        .maybeSingle();
+      if (clash && clash.id !== data.id) {
+        throw new Error("That place already has a checklist for this kind of job.");
+      }
+    }
+
+    const row = {
+      org_id: data.orgId,
+      name: data.name,
+      task_type: data.taskType,
+      property_id: data.propertyId,
+      // Only a shared template can be the workspace default.
+      is_default: data.propertyId ? false : data.isDefault,
+      is_active: data.isActive,
+    };
+
+    let checklistId = data.id ?? null;
+    if (checklistId) {
+      const { error } = await supabaseAdmin
+        .from("checklists")
+        .update(row)
+        .eq("id", checklistId)
+        .eq("org_id", data.orgId);
+      if (error) throw new Error("Could not save the checklist.");
+    } else {
+      const { data: created, error } = await supabaseAdmin
+        .from("checklists")
+        .insert(row)
+        .select("id")
+        .single();
+      if (error || !created) throw new Error("Could not create the checklist.");
+      checklistId = created.id;
+    }
+
+    // Only one shared default per job type.
+    if (row.is_default) {
+      await supabaseAdmin
+        .from("checklists")
+        .update({ is_default: false })
+        .eq("org_id", data.orgId)
+        .eq("task_type", data.taskType)
+        .is("property_id", null)
+        .neq("id", checklistId);
+    }
+
+    // Lines are replaced wholesale — already-created jobs keep their own copy.
+    await supabaseAdmin.from("checklist_items").delete().eq("checklist_id", checklistId);
+    if (data.items.length) {
+      const { error } = await supabaseAdmin.from("checklist_items").insert(
+        data.items.map((i, index) => ({
+          org_id: data.orgId,
+          checklist_id: checklistId,
+          label: i.label,
+          room: i.room || "General",
+          requires_photo: i.requiresPhoto,
+          position: index,
+        })),
+      );
+      if (error) throw new Error("Could not save the checklist lines.");
+    }
+
+    await logAudit({
+      orgId: data.orgId,
+      actorId: context.userId,
+      action: data.id ? "checklist.updated" : "checklist.created",
+      entityType: "checklist",
+      entityId: checklistId,
+      metadata: { name: data.name, taskType: data.taskType },
+    });
+
+    return { id: checklistId };
+  });
+
+export const deleteChecklist = createServerFn({ method: "POST" })
+  .middleware([requireSupabaseAuth])
+  .inputValidator((d: unknown) =>
+    z.object({ orgId: z.string().uuid(), id: z.string().uuid() }).parse(d),
+  )
+  .handler(async ({ data, context }) => {
+    const { requireMembership, supabaseAdmin, ADMIN_ROLES, logAudit } = await import("./ops.server");
+    await requireMembership(context.userId, data.orgId, ADMIN_ROLES);
+
+    // Jobs reference the checklist they were built from; keep that history by
+    // retiring the template rather than deleting it.
+    const { error } = await supabaseAdmin
+      .from("checklists")
+      .update({ is_active: false, is_default: false })
+      .eq("id", data.id)
+      .eq("org_id", data.orgId);
+    if (error) throw new Error("Could not retire the checklist.");
+
+    await logAudit({
+      orgId: data.orgId,
+      actorId: context.userId,
+      action: "checklist.retired",
+      entityType: "checklist",
+      entityId: data.id,
+    });
+    return { ok: true };
+  });
