+ALTER TABLE public.checklists
+  ADD COLUMN IF NOT EXISTS property_id UUID REFERENCES public.properties(id) ON DELETE CASCADE,
+  ADD COLUMN IF NOT EXISTS is_active BOOLEAN NOT NULL DEFAULT true;
+
+CREATE INDEX IF NOT EXISTS checklists_lookup_idx
+  ON public.checklists (org_id, task_type, property_id, is_active);
+
+CREATE TABLE IF NOT EXISTS public.amenity_templates (
+  id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
+  org_id UUID NOT NULL REFERENCES public.organizations(id) ON DELETE CASCADE,
+  name TEXT NOT NULL,
+  is_active BOOLEAN NOT NULL DEFAULT true,
+  created_at TIMESTAMPTZ NOT NULL DEFAULT now(),
+  updated_at TIMESTAMPTZ NOT NULL DEFAULT now(),
+  UNIQUE (org_id, name)
+);
+
+GRANT SELECT ON public.amenity_templates TO authenticated;
+GRANT ALL ON public.amenity_templates TO service_role;
+ALTER TABLE public.amenity_templates ENABLE ROW LEVEL SECURITY;
+
+CREATE POLICY "Members read amenity templates"
+  ON public.amenity_templates FOR SELECT TO authenticated
+  USING (public.is_org_member(org_id));
+
+CREATE TRIGGER t_amenity_templates_upd
+  BEFORE UPDATE ON public.amenity_templates
+  FOR EACH ROW EXECUTE FUNCTION public.set_updated_at();
+
+CREATE TABLE IF NOT EXISTS public.amenity_template_items (
+  id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
+  org_id UUID NOT NULL REFERENCES public.organizations(id) ON DELETE CASCADE,
+  template_id UUID NOT NULL REFERENCES public.amenity_templates(id) ON DELETE CASCADE,
+  name TEXT NOT NULL,
+  expected_qty INTEGER NOT NULL DEFAULT 1 CHECK (expected_qty >= 0),
+  unit TEXT,
+  sort_order INTEGER NOT NULL DEFAULT 0,
+  UNIQUE (template_id, name)
+);
+
+GRANT SELECT ON public.amenity_template_items TO authenticated;
+GRANT ALL ON public.amenity_template_items TO service_role;
+ALTER TABLE public.amenity_template_items ENABLE ROW LEVEL SECURITY;
+
+CREATE POLICY "Members read amenity template items"
+  ON public.amenity_template_items FOR SELECT TO authenticated
+  USING (public.is_org_member(org_id));
+
+CREATE INDEX IF NOT EXISTS amenity_template_items_template_idx
+  ON public.amenity_template_items (template_id, sort_order, name);
+
+ALTER TABLE public.amenity_definitions
+  ADD COLUMN IF NOT EXISTS template_id UUID REFERENCES public.amenity_templates(id) ON DELETE SET NULL,
+  ADD COLUMN IF NOT EXISTS template_item_id UUID REFERENCES public.amenity_template_items(id) ON DELETE SET NULL,
+  ADD COLUMN IF NOT EXISTS qty_overridden BOOLEAN NOT NULL DEFAULT false;
+
+CREATE INDEX IF NOT EXISTS amenity_definitions_template_idx
+  ON public.amenity_definitions (template_id);
+
+ALTER TABLE public.properties
+  ADD COLUMN IF NOT EXISTS amenity_template_id UUID REFERENCES public.amenity_templates(id) ON DELETE SET NULL;
