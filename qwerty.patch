+
+/* ---------------------------------------------------------------- motion --
+ * Brand motion: slow and water-like, never attention-grabbing. Everything
+ * below is switched off for visitors who ask for reduced motion.
+ */
+
+@keyframes airclean-sheen {
+  0%, 100% { opacity: 0.35; transform: translateY(0); }
+  50% { opacity: 1; transform: translateY(-1px); }
+}
+
+@keyframes airclean-drift {
+  0%, 100% { transform: translateX(0); opacity: 0.55; }
+  50% { transform: translateX(2.5px); opacity: 1; }
+}
+
+@keyframes airclean-float {
+  0%, 100% { transform: translateY(0); }
+  50% { transform: translateY(-8px); }
+}
+
+@keyframes airclean-rise {
+  from { opacity: 0; transform: translateY(14px); }
+  to { opacity: 1; transform: none; }
+}
+
+@keyframes airclean-pop {
+  0% { transform: scale(0.6); opacity: 0; }
+  70% { transform: scale(1.08); opacity: 1; }
+  100% { transform: scale(1); }
+}
+
+@keyframes airclean-aurora {
+  0% { transform: translate3d(-6%, -4%, 0) scale(1); }
+  50% { transform: translate3d(6%, 4%, 0) scale(1.12); }
+  100% { transform: translate3d(-6%, -4%, 0) scale(1); }
+}
+
+@keyframes airclean-shimmer {
+  from { background-position: 200% 0; }
+  to { background-position: -200% 0; }
+}
+
+@utility animate-sheen {
+  animation: airclean-sheen 3.2s ease-in-out infinite;
+}
+
+@utility animate-drift {
+  animation: airclean-drift 4s ease-in-out infinite;
+}
+
+@utility animate-float {
+  animation: airclean-float 6s ease-in-out infinite;
+}
+
+@utility animate-rise {
+  animation: airclean-rise 620ms cubic-bezier(0.22, 1, 0.36, 1) both;
+}
+
+@utility animate-pop {
+  animation: airclean-pop 420ms cubic-bezier(0.22, 1, 0.36, 1) both;
+}
+
+/* Soft moving colour wash behind hero and public pages. */
+@utility aurora {
+  position: absolute;
+  inset: -20% -10% auto -10%;
+  height: 60vh;
+  pointer-events: none;
+  z-index: 0;
+  background:
+    radial-gradient(40% 50% at 20% 30%, color-mix(in oklab, var(--primary) 32%, transparent), transparent 70%),
+    radial-gradient(35% 45% at 75% 20%, color-mix(in oklab, var(--primary-glow) 34%, transparent), transparent 70%);
+  filter: blur(46px);
+  animation: airclean-aurora 18s ease-in-out infinite;
+}
+
+/* Gentle lift on cards and tiles. */
+@utility hover-lift {
+  transition: transform var(--transition-base), box-shadow var(--transition-base);
+
+  &:hover {
+    transform: translateY(-3px);
+    box-shadow: var(--shadow-glow);
+  }
+}
+
+/* Sweeping highlight for headline words. */
+@utility shimmer-text {
+  background: linear-gradient(100deg, var(--primary) 20%, var(--primary-glow) 40%, var(--primary) 60%);
+  background-size: 200% auto;
+  -webkit-background-clip: text;
+  background-clip: text;
+  color: transparent;
+  animation: airclean-shimmer 6s linear infinite;
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .animate-sheen,
+  .animate-drift,
+  .animate-float,
+  .animate-rise,
+  .animate-pop,
+  .aurora,
+  .shimmer-text {
+    animation: none !important;
+  }
+}
