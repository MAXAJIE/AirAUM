@@ -0,0 +1,318 @@
+import { createServerFn } from "@tanstack/react-start";
+import { requireSupabaseAuth } from "@/integrations/supabase/auth-middleware";
+import { z } from "zod";
+
+/**
+ * Room supply templates ("2 bath towels, 1 shampoo, …").
+ *
+ * A place follows one template. Template edits flow through to every linked
+ * place, except for a quantity the place has deliberately changed.
+ */
+
+export type AmenityTemplateItem = {
+  id: string;
+  name: string;
+  expectedQty: number;
+  unit: string | null;
+  sortOrder: number;
+};
+
+export type AmenityTemplate = {
+  id: string;
+  name: string;
+  isActive: boolean;
+  items: AmenityTemplateItem[];
+  linkedProperties: { id: string; name: string }[];
+};
+
+export const listAmenityTemplates = createServerFn({ method: "POST" })
+  .middleware([requireSupabaseAuth])
+  .inputValidator((d: unknown) => z.object({ orgId: z.string().uuid() }).parse(d))
+  .handler(async ({ data, context }): Promise<AmenityTemplate[]> => {
+    const { requireMembership, supabaseAdmin, STAFF_ROLES } = await import("./ops.server");
+    await requireMembership(context.userId, data.orgId, STAFF_ROLES);
+
+    const [{ data: templates }, { data: items }, { data: properties }] = await Promise.all([
+      supabaseAdmin
+        .from("amenity_templates")
+        .select("id, name, is_active")
+        .eq("org_id", data.orgId)
+        .order("name"),
+      supabaseAdmin
+        .from("amenity_template_items")
+        .select("id, template_id, name, expected_qty, unit, sort_order")
+        .eq("org_id", data.orgId)
+        .order("sort_order"),
+      supabaseAdmin
+        .from("properties")
+        .select("id, name, amenity_template_id")
+        .eq("org_id", data.orgId)
+        .order("name"),
+    ]);
+
+    return (templates ?? []).map((t) => ({
+      id: t.id,
+      name: t.name,
+      isActive: t.is_active,
+      items: (items ?? [])
+        .filter((i) => i.template_id === t.id)
+        .map((i) => ({
+          id: i.id,
+          name: i.name,
+          expectedQty: i.expected_qty,
+          unit: i.unit,
+          sortOrder: i.sort_order,
+        })),
+      linkedProperties: (properties ?? [])
+        .filter((p) => p.amenity_template_id === t.id)
+        .map((p) => ({ id: p.id, name: p.name })),
+    }));
+  });
+
+export const saveAmenityTemplate = createServerFn({ method: "POST" })
+  .middleware([requireSupabaseAuth])
+  .inputValidator((d: unknown) =>
+    z
+      .object({
+        orgId: z.string().uuid(),
+        id: z.string().uuid().optional(),
+        name: z.string().trim().min(1).max(120),
+        items: z
+          .array(
+            z.object({
+              id: z.string().uuid().optional(),
+              name: z.string().trim().min(1).max(120),
+              expectedQty: z.number().int().min(0).max(999),
+              unit: z.string().trim().max(30).nullable().default(null),
+            }),
+          )
+          .max(100),
+      })
+      .parse(d),
+  )
+  .handler(async ({ data, context }) => {
+    const { requireMembership, supabaseAdmin, ADMIN_ROLES, logAudit } = await import("./ops.server");
+    await requireMembership(context.userId, data.orgId, ADMIN_ROLES);
+
+    let templateId = data.id ?? null;
+    if (templateId) {
+      const { error } = await supabaseAdmin
+        .from("amenity_templates")
+        .update({ name: data.name })
+        .eq("id", templateId)
+        .eq("org_id", data.orgId);
+      if (error) throw new Error("Could not save the supply list.");
+    } else {
+      const { data: created, error } = await supabaseAdmin
+        .from("amenity_templates")
+        .insert({ org_id: data.orgId, name: data.name })
+        .select("id")
+        .single();
+      if (error || !created) throw new Error("A supply list with that name already exists.");
+      templateId = created.id;
+    }
+
+    const { data: existing } = await supabaseAdmin
+      .from("amenity_template_items")
+      .select("id")
+      .eq("template_id", templateId);
+    const keep = new Set(data.items.map((i) => i.id).filter(Boolean) as string[]);
+    for (const row of existing ?? []) {
+      if (!keep.has(row.id)) {
+        await supabaseAdmin.from("amenity_template_items").delete().eq("id", row.id);
+      }
+    }
+
+    for (const [index, item] of data.items.entries()) {
+      const values = {
+        org_id: data.orgId,
+        template_id: templateId,
+        name: item.name,
+        expected_qty: item.expectedQty,
+        unit: item.unit,
+        sort_order: index,
+      };
+      if (item.id) {
+        await supabaseAdmin.from("amenity_template_items").update(values).eq("id", item.id);
+      } else {
+        await supabaseAdmin.from("amenity_template_items").insert(values);
+      }
+    }
+
+    const { syncTemplateToProperties } = await import("./amenities.server");
+    await syncTemplateToProperties(data.orgId, templateId);
+
+    await logAudit({
+      orgId: data.orgId,
+      actorId: context.userId,
+      action: data.id ? "amenity_template.updated" : "amenity_template.created",
+      entityType: "amenity_template",
+      entityId: templateId,
+      metadata: { name: data.name },
+    });
+
+    return { id: templateId };
+  });
+
+export const deleteAmenityTemplate = createServerFn({ method: "POST" })
+  .middleware([requireSupabaseAuth])
+  .inputValidator((d: unknown) =>
+    z.object({ orgId: z.string().uuid(), id: z.string().uuid() }).parse(d),
+  )
+  .handler(async ({ data, context }) => {
+    const { requireMembership, supabaseAdmin, ADMIN_ROLES, logAudit } = await import("./ops.server");
+    await requireMembership(context.userId, data.orgId, ADMIN_ROLES);
+
+    // Places keep the supply lines they already have; they simply stop
+    // following the template.
+    await supabaseAdmin
+      .from("amenity_definitions")
+      .update({ template_id: null, template_item_id: null })
+      .eq("org_id", data.orgId)
+      .eq("template_id", data.id);
+    await supabaseAdmin
+      .from("properties")
+      .update({ amenity_template_id: null })
+      .eq("org_id", data.orgId)
+      .eq("amenity_template_id", data.id);
+
+    const { error } = await supabaseAdmin
+      .from("amenity_templates")
+      .delete()
+      .eq("id", data.id)
+      .eq("org_id", data.orgId);
+    if (error) throw new Error("Could not delete the supply list.");
+
+    await logAudit({
+      orgId: data.orgId,
+      actorId: context.userId,
+      action: "amenity_template.deleted",
+      entityType: "amenity_template",
+      entityId: data.id,
+    });
+    return { ok: true };
+  });
+
+/** Links a place to a supply template (or unlinks it when templateId is null). */
+export const applyAmenityTemplate = createServerFn({ method: "POST" })
+  .middleware([requireSupabaseAuth])
+  .inputValidator((d: unknown) =>
+    z
+      .object({
+        orgId: z.string().uuid(),
+        propertyId: z.string().uuid(),
+        templateId: z.string().uuid().nullable(),
+      })
+      .parse(d),
+  )
+  .handler(async ({ data, context }) => {
+    const { requireMembership, supabaseAdmin, ADMIN_ROLES, logAudit } = await import("./ops.server");
+    await requireMembership(context.userId, data.orgId, ADMIN_ROLES);
+
+    // Drop the lines from any template the place used to follow. Lines it
+    // added by hand (no template) are left alone.
+    await supabaseAdmin
+      .from("amenity_definitions")
+      .delete()
+      .eq("property_id", data.propertyId)
+      .not("template_id", "is", null);
+
+    const { error } = await supabaseAdmin
+      .from("properties")
+      .update({ amenity_template_id: data.templateId })
+      .eq("id", data.propertyId)
+      .eq("org_id", data.orgId);
+    if (error) throw new Error("Could not apply the supply list.");
+
+    if (data.templateId) {
+      const { syncTemplateToProperties } = await import("./amenities.server");
+      await syncTemplateToProperties(data.orgId, data.templateId);
+    }
+
+    await logAudit({
+      orgId: data.orgId,
+      actorId: context.userId,
+      action: "amenity_template.applied",
+      entityType: "property",
+      entityId: data.propertyId,
+      metadata: { templateId: data.templateId ?? "none" },
+    });
+    return { ok: true };
+  });
+
