index 0000000..2c1a413
--- /dev/null
+++ b/src/routes/_authenticated/checklists.tsx
@@ -0,0 +1,430 @@
+import { createFileRoute } from "@tanstack/react-router";
+import { useMutation, useQuery, useQueryClient } from "@tanstack/react-query";
+import { useState } from "react";
+import { toast } from "sonner";
+import { AppShell } from "@/components/app-shell";
+import { useWorkspace, isAdmin } from "@/hooks/useWorkspace";
+import {
+  listChecklists,
+  saveChecklist,
+  deleteChecklist,
+  type ChecklistRow,
+} from "@/lib/checklists.functions";
+import { listProperties } from "@/lib/properties.functions";
+import { Card, CardContent } from "@/components/ui/card";
+import { Button } from "@/components/ui/button";
+import { Input } from "@/components/ui/input";
+import { Label } from "@/components/ui/label";
+import { Badge } from "@/components/ui/badge";
+import { Switch } from "@/components/ui/switch";
+import { Skeleton } from "@/components/ui/skeleton";
+import {
+  Dialog,
+  DialogContent,
+  DialogDescription,
+  DialogHeader,
+  DialogTitle,
+} from "@/components/ui/dialog";
+import {
+  Select,
+  SelectContent,
+  SelectItem,
+  SelectTrigger,
+  SelectValue,
+} from "@/components/ui/select";
+
+export const Route = createFileRoute("/_authenticated/checklists")({
+  head: () => ({
+    meta: [
+      { title: "Cleaning checklists — AirClean" },
+      {
+        name: "description",
+        content:
+          "Build reusable cleaning checklists for your workspace and give a single place its own version when it needs one.",
+      },
+      { property: "og:title", content: "Cleaning checklists — AirClean" },
+      {
+        property: "og:description",
+        content: "Reusable cleaning checklists, with per-place overrides.",
+      },
+      { property: "og:type", content: "website" },
+      { name: "twitter:card", content: "summary" },
+    ],
+  }),
+  component: ChecklistsPage,
+});
+
+const TASK_TYPES = [
+  { value: "turnover_clean", label: "🧹 Turnover clean" },
+  { value: "deep_clean", label: "✨ Deep clean" },
+  { value: "inspection", label: "🔎 Inspection" },
+  { value: "maintenance", label: "🔧 Maintenance" },
+  { value: "restock", label: "🧴 Restock" },
+] as const;
+
+type TaskType = (typeof TASK_TYPES)[number]["value"];
+type DraftItem = { label: string; room: string; requiresPhoto: boolean };
+
+type Draft = {
+  id?: string;
+  name: string;
+  taskType: TaskType;
+  propertyId: string | null;
+  isDefault: boolean;
+  isActive: boolean;
+  items: DraftItem[];
+};
+
+const emptyDraft = (): Draft => ({
+  name: "",
+  taskType: "turnover_clean",
+  propertyId: null,
+  isDefault: false,
+  isActive: true,
+  items: [{ label: "", room: "General", requiresPhoto: false }],
+});
+
+function ChecklistsPage() {
+  const { orgId, workspace } = useWorkspace();
+  const qc = useQueryClient();
+  const admin = isAdmin(workspace?.role);
+  const [draft, setDraft] = useState<Draft | null>(null);
+
+  const lists = useQuery({
+    queryKey: ["checklists", orgId],
+    queryFn: () => listChecklists({ data: { orgId: orgId! } }),
+    enabled: !!orgId,
+  });
+
+  const properties = useQuery({
+    queryKey: ["properties", orgId],
+    queryFn: () => listProperties({ data: { orgId: orgId! } }),
+    enabled: !!orgId,
+  });
+
+  const save = useMutation({
+    mutationFn: (d: Draft) =>
+      saveChecklist({
+        data: {
+          orgId: orgId!,
+          ...(d.id ? { id: d.id } : {}),
+          name: d.name.trim(),
+          taskType: d.taskType,
+          propertyId: d.propertyId,
+          isDefault: d.isDefault,
+          isActive: d.isActive,
+          items: d.items
+            .filter((i) => i.label.trim())
+            .map((i) => ({
+              label: i.label.trim(),
+              room: i.room.trim() || "General",
+              requiresPhoto: i.requiresPhoto,
+            })),
+        },
+      }),
+    onSuccess: () => {
+      toast.success("✅ Checklist saved.");
+      setDraft(null);
+      qc.invalidateQueries({ queryKey: ["checklists", orgId] });
+    },
+    onError: (e: Error) => toast.error(e.message),
+  });
+
+  const retire = useMutation({
+    mutationFn: (id: string) => deleteChecklist({ data: { orgId: orgId!, id } }),
+    onSuccess: () => {
+      toast.success("Checklist retired.");
+      qc.invalidateQueries({ queryKey: ["checklists", orgId] });
+    },
+    onError: (e: Error) => toast.error(e.message),
+  });
+
+  const rows = lists.data ?? [];
+  const shared = rows.filter((r) => !r.propertyId);
+  const overrides = rows.filter((r) => r.propertyId);
+
+  const toDraft = (r: ChecklistRow): Draft => ({
+    id: r.id,
+    name: r.name,
+    taskType: r.taskType,
+    propertyId: r.propertyId,
+    isDefault: r.isDefault,
+    isActive: r.isActive,
+    items: r.items.length
+      ? r.items.map((i) => ({ label: i.label, room: i.room, requiresPhoto: i.requiresPhoto }))
+      : [{ label: "", room: "General", requiresPhoto: false }],
+  });
+
+  return (
+    <AppShell title="Checklists">
+      <div className="space-y-6">
+        <div className="flex flex-wrap items-center gap-3">
+          <p className="text-sm text-muted-foreground">
+            Shared checklists are copied onto every new job. A place can keep its own version for
+            one kind of job, and that one wins.
+          </p>
+          {admin && (
+            <Button size="sm" className="ml-auto" onClick={() => setDraft(emptyDraft())}>
+              ➕ New checklist
+            </Button>
+          )}
+        </div>
+
+        {lists.isLoading && <Skeleton className="h-40 w-full" />}
+
+        {!lists.isLoading && rows.length === 0 && (
+          <Card>
+            <CardContent className="p-8 text-center text-sm text-muted-foreground">
+              📋 No checklists yet. Create one and every new job will start from it.
+            </CardContent>
+          </Card>
+        )}
+
+        {shared.length > 0 && (
+          <section className="space-y-3">
+            <h2 className="font-display text-sm font-semibold uppercase tracking-wide text-muted-foreground">
+              Shared templates
+            </h2>
+            <div className="grid gap-3 md:grid-cols-2">
+              {shared.map((r) => (
+                <ChecklistCard
+                  key={r.id}
+                  row={r}
+                  admin={admin}
+                  onEdit={() => setDraft(toDraft(r))}
+                  onRetire={() => retire.mutate(r.id)}
+                />
+              ))}
+            </div>
+          </section>
+        )}
+
+        {overrides.length > 0 && (
+          <section className="space-y-3">
+            <h2 className="font-display text-sm font-semibold uppercase tracking-wide text-muted-foreground">
+              Place-specific
+            </h2>
+            <div className="grid gap-3 md:grid-cols-2">
+              {overrides.map((r) => (
+                <ChecklistCard
+                  key={r.id}
+                  row={r}
+                  admin={admin}
+                  onEdit={() => setDraft(toDraft(r))}
+                  onRetire={() => retire.mutate(r.id)}
+                />
+              ))}
+            </div>
+          </section>
+        )}
+      </div>
+
+      <Dialog open={!!draft} onOpenChange={(o) => !o && setDraft(null)}>
+        <DialogContent className="max-h-[90vh] max-w-2xl overflow-y-auto">
+          <DialogHeader>
+            <DialogTitle>{draft?.id ? "Edit checklist" : "New checklist"}</DialogTitle>
+            <DialogDescription>
+              Lines are copied onto new jobs. Jobs already created keep the lines they were given.
+            </DialogDescription>
+          </DialogHeader>
+
+          {draft && (
+            <div className="space-y-4">
+              <div className="grid gap-4 sm:grid-cols-2">
+                <div className="space-y-2">
+                  <Label htmlFor="cl-name">Name</Label>
+                  <Input
+                    id="cl-name"
+                    value={draft.name}
+                    placeholder="Standard turnover"
+                    onChange={(e) => setDraft({ ...draft, name: e.target.value })}
+                  />
+                </div>
+                <div className="space-y-2">
+                  <Label>Kind of job</Label>
+                  <Select
+                    value={draft.taskType}
+                    onValueChange={(v) => setDraft({ ...draft, taskType: v as TaskType })}
+                  >
+                    <SelectTrigger>
+                      <SelectValue />
+                    </SelectTrigger>
+                    <SelectContent>
+                      {TASK_TYPES.map((t) => (
+                        <SelectItem key={t.value} value={t.value}>
+                          {t.label}
+                        </SelectItem>
+                      ))}
+                    </SelectContent>
+                  </Select>
+                </div>
+              </div>
+
+              <div className="space-y-2">
+                <Label>Applies to</Label>
+                <Select
+                  value={draft.propertyId ?? "all"}
+                  onValueChange={(v) =>
+                    setDraft({ ...draft, propertyId: v === "all" ? null : v, isDefault: false })
+                  }
+                >
+                  <SelectTrigger>
+                    <SelectValue />
+                  </SelectTrigger>
+                  <SelectContent>
+                    <SelectItem value="all">Every place (shared template)</SelectItem>
+                    {(properties.data ?? [])
+                      .filter((p) => p.active)
+                      .map((p) => (
+                        <SelectItem key={p.id} value={p.id}>
+                          {p.name}
+                          {p.unitLabel ? ` · ${p.unitLabel}` : ""}
+                        </SelectItem>
+                      ))}
+                  </SelectContent>
+                </Select>
+              </div>
+
+              {!draft.propertyId && (
+                <label className="flex items-center gap-3 text-sm">
+                  <Switch
+                    checked={draft.isDefault}
+                    onCheckedChange={(v) => setDraft({ ...draft, isDefault: v })}
+                  />
+                  Use this as the default for this kind of job
+                </label>
+              )}
+
+              <label className="flex items-center gap-3 text-sm">
+                <Switch
+                  checked={draft.isActive}
+                  onCheckedChange={(v) => setDraft({ ...draft, isActive: v })}
+                />
+                In use
+              </label>
+
+              <div className="space-y-2">
+                <Label>Lines</Label>
+                <div className="space-y-2">
+                  {draft.items.map((item, index) => (
+                    <div key={index} className="flex flex-wrap items-center gap-2">
+                      <Input
+                        className="min-w-48 flex-1"
+                        value={item.label}
+                        placeholder="Strip and remake the beds"
+                        onChange={(e) => {
+                          const items = [...draft.items];
+                          items[index] = { ...item, label: e.target.value };
+                          setDraft({ ...draft, items });
+                        }}
+                      />
+                      <Input
+                        className="w-32"
+                        value={item.room}
+                        placeholder="Room"
+                        onChange={(e) => {
+                          const items = [...draft.items];
+                          items[index] = { ...item, room: e.target.value };
+                          setDraft({ ...draft, items });
+                        }}
+                      />
+                      <label className="flex items-center gap-2 text-xs text-muted-foreground">
+                        <Switch
+                          checked={item.requiresPhoto}
+                          onCheckedChange={(v) => {
+                            const items = [...draft.items];
+                            items[index] = { ...item, requiresPhoto: v };
+                            setDraft({ ...draft, items });
+                          }}
+                        />
+                        Photo
+                      </label>
+                      <Button
+                        type="button"
+                        size="sm"
+                        variant="ghost"
+                        onClick={() =>
+                          setDraft({
+                            ...draft,
+                            items: draft.items.filter((_, i) => i !== index),
+                          })
+                        }
+                      >
+                        ✕
+                      </Button>
+                    </div>
+                  ))}
+                </div>
+                <Button
+                  type="button"
+                  size="sm"
+                  variant="outline"
+                  onClick={() =>
+                    setDraft({
+                      ...draft,
+                      items: [...draft.items, { label: "", room: "General", requiresPhoto: false }],
+                    })
+                  }
+                >
+                  ➕ Add line
+                </Button>
+              </div>
+
+              <Button
+                className="w-full"
+                disabled={!draft.name.trim() || save.isPending}
+                onClick={() => save.mutate(draft)}
+              >
+                {save.isPending ? "Saving…" : "Save checklist"}
+              </Button>
+            </div>
+          )}
+        </DialogContent>
+      </Dialog>
+    </AppShell>
+  );
+}
+
+function ChecklistCard({
+  row,
+  admin,
+  onEdit,
+  onRetire,
+}: {
+  row: ChecklistRow;
+  admin: boolean;
+  onEdit: () => void;
+  onRetire: () => void;
+}) {
+  const type = TASK_TYPES.find((t) => t.value === row.taskType);
+  return (
+    <Card className={row.isActive ? "" : "opacity-60"}>
+      <CardContent className="space-y-2 p-4">
+        <div className="flex flex-wrap items-center gap-2">
+          <p className="font-medium">{row.name}</p>
+          <Badge variant="secondary">{type?.label ?? row.taskType}</Badge>
+          {row.isDefault && <Badge>Default</Badge>}
+          {row.propertyName && <Badge variant="outline">{row.propertyName}</Badge>}
+          {!row.isActive && <Badge variant="outline">Retired</Badge>}
+        </div>
+        <p className="text-sm text-muted-foreground">
+          {row.items.length} line{row.items.length === 1 ? "" : "s"}
+          {row.items.length > 0 && ` · ${row.items.slice(0, 3).map((i) => i.label).join(", ")}`}
+          {row.items.length > 3 && "…"}
+        </p>
+        {admin && (
+          <div className="flex gap-2 pt-1">
+            <Button size="sm" variant="outline" onClick={onEdit}>
+              Edit
+            </Button>
+            {row.isActive && (
+              <Button size="sm" variant="ghost" onClick={onRetire}>
+                Retire
+              </Button>
+            )}
+          </div>
+        )}
+      </CardContent>
+    </Card>
+  );
+}
