+/** One collapsible sidebar group. The open/closed choice is remembered per browser. */
+function NavSection({
+  group,
+  pathname,
+  onNavigate,
+}: {
+  group: { id: string; label: string; items: NavItem[] };
+  pathname: string;
+  onNavigate: () => void;
+}) {
+  const [collapsed, setCollapsed] = useState(false);
+
+  useEffect(() => {
+    try {
+      const raw = window.localStorage.getItem(COLLAPSE_KEY);
+      const ids: string[] = raw ? JSON.parse(raw) : [];
+      setCollapsed(ids.includes(group.id));
+    } catch {
+      /* storage unavailable */
+    }
+  }, [group.id]);
+
+  const toggle = () => {
+    const next = !collapsed;
+    setCollapsed(next);
+    try {
+      const raw = window.localStorage.getItem(COLLAPSE_KEY);
+      const ids: string[] = raw ? JSON.parse(raw) : [];
+      const updated = next ? [...new Set([...ids, group.id])] : ids.filter((i) => i !== group.id);
+      window.localStorage.setItem(COLLAPSE_KEY, JSON.stringify(updated));
+    } catch {
+      /* storage unavailable */
+    }
+  };
+
+  return (
+    <div>
+      <button
+        type="button"
+        onClick={toggle}
+        aria-expanded={!collapsed}
+        className="flex w-full items-center justify-between rounded px-3 py-1 text-xs font-semibold uppercase tracking-wide text-muted-foreground transition-colors hover:text-foreground"
+      >
+        {group.label}
+        <ChevronDown
+          className={`size-3.5 transition-transform ${collapsed ? "-rotate-90" : ""}`}
+          aria-hidden
+        />
+      </button>
+      {!collapsed && (
+        <div className="mt-1 flex flex-col gap-1">
+          {group.items.map((item) => {
+            const Icon = item.icon;
+            const current = pathname.startsWith(item.to);
+            return (
+              <Link
+                key={item.to}
+                to={item.to}
+                onClick={onNavigate}
+                className={`flex items-center gap-3 rounded-lg px-3 py-2 text-sm font-medium transition-colors ${
+                  current
+                    ? "bg-primary/10 text-primary shadow-[inset_2px_0_0_0_var(--primary)]"
+                    : "text-muted-foreground hover:translate-x-0.5 hover:bg-muted hover:text-foreground"
+                }`}
+              >
+                <Icon className="size-4" aria-hidden />
+                {item.label}
+              </Link>
+            );
+          })}
+        </div>
+      )}
+    </div>
+  );
+}
