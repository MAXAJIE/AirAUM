new file mode 100644
index 0000000..2aaa23c
--- /dev/null
+++ b/src/routes/_authenticated/supplies.tsx
@@ -0,0 +1,348 @@
+import { createFileRoute } from "@tanstack/react-router";
+import { useMutation, useQuery, useQueryClient } from "@tanstack/react-query";
+import { useState } from "react";
+import { toast } from "sonner";
+import { AppShell } from "@/components/app-shell";
+import { useWorkspace, isAdmin } from "@/hooks/useWorkspace";
+import {
+  listAmenityTemplates,
+  saveAmenityTemplate,
+  deleteAmenityTemplate,
+  applyAmenityTemplate,
+  type AmenityTemplate,
+} from "@/lib/amenities.functions";
+import { listProperties } from "@/lib/properties.functions";
+import { Card, CardContent } from "@/components/ui/card";
+import { Button } from "@/components/ui/button";
+import { Input } from "@/components/ui/input";
+import { Label } from "@/components/ui/label";
+import { Badge } from "@/components/ui/badge";
+import { Skeleton } from "@/components/ui/skeleton";
+import {
+  Dialog,
+  DialogContent,
+  DialogDescription,
+  DialogHeader,
+  DialogTitle,
+} from "@/components/ui/dialog";
+import {
+  Select,
+  SelectContent,
+  SelectItem,
+  SelectTrigger,
+  SelectValue,
+} from "@/components/ui/select";
+
+export const Route = createFileRoute("/_authenticated/supplies")({
+  head: () => ({
+    meta: [
+      { title: "Supply lists — AirClean" },
+      {
+        name: "description",
+        content:
+          "Set out what every room should contain — towels, toiletries, coffee — and apply the same list to as many places as you like.",
+      },
+      { property: "og:title", content: "Supply lists — AirClean" },
+      {
+        property: "og:description",
+        content: "Reusable room supply lists your guests and cleaners count against.",
+      },
+      { property: "og:type", content: "website" },
+      { name: "twitter:card", content: "summary" },
+    ],
+  }),
+  component: SuppliesPage,
+});
+
+type DraftItem = { id?: string; name: string; expectedQty: number; unit: string | null };
+type Draft = { id?: string; name: string; items: DraftItem[] };
+
+const emptyDraft = (): Draft => ({
+  name: "",
+  items: [{ name: "", expectedQty: 1, unit: null }],
+});
+
+function SuppliesPage() {
+  const { orgId, workspace } = useWorkspace();
+  const qc = useQueryClient();
+  const admin = isAdmin(workspace?.role);
+  const [draft, setDraft] = useState<Draft | null>(null);
+
+  const templates = useQuery({
+    queryKey: ["amenity-templates", orgId],
+    queryFn: () => listAmenityTemplates({ data: { orgId: orgId! } }),
+    enabled: !!orgId,
+  });
+
+  const properties = useQuery({
+    queryKey: ["properties", orgId],
+    queryFn: () => listProperties({ data: { orgId: orgId! } }),
+    enabled: !!orgId,
+  });
+
+  const invalidate = () => {
+    qc.invalidateQueries({ queryKey: ["amenity-templates", orgId] });
+    qc.invalidateQueries({ queryKey: ["properties", orgId] });
+  };
+
+  const save = useMutation({
+    mutationFn: (d: Draft) =>
+      saveAmenityTemplate({
+        data: {
+          orgId: orgId!,
+          ...(d.id ? { id: d.id } : {}),
+          name: d.name.trim(),
+          items: d.items
+            .filter((i) => i.name.trim())
+            .map((i) => ({
+              ...(i.id ? { id: i.id } : {}),
+              name: i.name.trim(),
+              expectedQty: i.expectedQty,
+              unit: i.unit?.trim() ? i.unit.trim() : null,
+            })),
+        },
+      }),
+    onSuccess: () => {
+      toast.success("✅ Supply list saved — linked places are up to date.");
+      setDraft(null);
+      invalidate();
+    },
+    onError: (e: Error) => toast.error(e.message),
+  });
+
+  const remove = useMutation({
+    mutationFn: (id: string) => deleteAmenityTemplate({ data: { orgId: orgId!, id } }),
+    onSuccess: () => {
+      toast.success("Supply list deleted.");
+      invalidate();
+    },
+    onError: (e: Error) => toast.error(e.message),
+  });
+
+  const apply = useMutation({
+    mutationFn: (v: { propertyId: string; templateId: string | null }) =>
+      applyAmenityTemplate({ data: { orgId: orgId!, ...v } }),
+    onSuccess: () => {
+      toast.success("✅ Applied.");
+      invalidate();
+    },
+    onError: (e: Error) => toast.error(e.message),
+  });
+
+  const rows = templates.data ?? [];
+  const activeProperties = (properties.data ?? []).filter((p) => p.active);
+  const linkedTemplateFor = (propertyId: string) =>
+    rows.find((t) => t.linkedProperties.some((p) => p.id === propertyId))?.id ?? "none";
+
+  const toDraft = (t: AmenityTemplate): Draft => ({
+    id: t.id,
+    name: t.name,
+    items: t.items.length
+      ? t.items.map((i) => ({ id: i.id, name: i.name, expectedQty: i.expectedQty, unit: i.unit }))
+      : [{ name: "", expectedQty: 1, unit: null }],
+  });
+
+  return (
+    <AppShell title="Supply lists">
+      <div className="space-y-6">
+        <div className="flex flex-wrap items-center gap-3">
+          <p className="text-sm text-muted-foreground">
+            What every room should contain. Places linked to a list stay in step with it — a
+            quantity you change on a single place is kept.
+          </p>
+          {admin && (
+            <Button size="sm" className="ml-auto" onClick={() => setDraft(emptyDraft())}>
+              ➕ New supply list
+            </Button>
+          )}
+        </div>
+
+        {templates.isLoading && <Skeleton className="h-40 w-full" />}
+
+        {!templates.isLoading && rows.length === 0 && (
+          <Card>
+            <CardContent className="p-8 text-center text-sm text-muted-foreground">
+              🧴 No supply lists yet. Create one, then link your places to it.
+            </CardContent>
+          </Card>
+        )}
+
+        <div className="grid gap-3 md:grid-cols-2">
+          {rows.map((t) => (
+            <Card key={t.id}>
+              <CardContent className="space-y-2 p-4">
+                <div className="flex flex-wrap items-center gap-2">
+                  <p className="font-medium">{t.name}</p>
+                  <Badge variant="secondary">
+                    {t.items.length} item{t.items.length === 1 ? "" : "s"}
+                  </Badge>
+                  <Badge variant="outline">
+                    {t.linkedProperties.length} place
+                    {t.linkedProperties.length === 1 ? "" : "s"}
+                  </Badge>
+                </div>
+                <p className="text-sm text-muted-foreground">
+                  {t.items
+                    .slice(0, 5)
+                    .map((i) => `${i.name} ×${i.expectedQty}${i.unit ? ` ${i.unit}` : ""}`)
+                    .join(" · ") || "No items yet"}
+                  {t.items.length > 5 && " …"}
+                </p>
+                {t.linkedProperties.length > 0 && (
+                  <p className="text-xs text-muted-foreground">
+                    Used by {t.linkedProperties.map((p) => p.name).join(", ")}
+                  </p>
+                )}
+                {admin && (
+                  <div className="flex gap-2 pt-1">
+                    <Button size="sm" variant="outline" onClick={() => setDraft(toDraft(t))}>
+                      Edit
+                    </Button>
+                    <Button size="sm" variant="ghost" onClick={() => remove.mutate(t.id)}>
+                      Delete
+                    </Button>
+                  </div>
+                )}
+              </CardContent>
+            </Card>
+          ))}
+        </div>
+
+        {admin && activeProperties.length > 0 && rows.length > 0 && (
+          <section className="space-y-3">
+            <h2 className="font-display text-sm font-semibold uppercase tracking-wide text-muted-foreground">
+              Which list each place uses
+            </h2>
+            <Card>
+              <CardContent className="divide-y divide-border p-0">
+                {activeProperties.map((p) => (
+                  <div key={p.id} className="flex flex-wrap items-center gap-3 p-4">
+                    <p className="text-sm font-medium">
+                      {p.name}
+                      {p.unitLabel ? ` · ${p.unitLabel}` : ""}
+                    </p>
+                    <Select
+                      value={linkedTemplateFor(p.id)}
+                      onValueChange={(v) =>
+                        apply.mutate({ propertyId: p.id, templateId: v === "none" ? null : v })
+                      }
+                    >
+                      <SelectTrigger className="ml-auto w-56">
+                        <SelectValue />
+                      </SelectTrigger>
+                      <SelectContent>
+                        <SelectItem value="none">No supply list</SelectItem>
+                        {rows.map((t) => (
+                          <SelectItem key={t.id} value={t.id}>
+                            {t.name}
+                          </SelectItem>
+                        ))}
+                      </SelectContent>
+                    </Select>
+                  </div>
+                ))}
+              </CardContent>
+            </Card>
+          </section>
+        )}
+      </div>
+
+      <Dialog open={!!draft} onOpenChange={(o) => !o && setDraft(null)}>
+        <DialogContent className="max-h-[90vh] overflow-y-auto">
+          <DialogHeader>
+            <DialogTitle>{draft?.id ? "Edit supply list" : "New supply list"}</DialogTitle>
+            <DialogDescription>
+              Saving pushes the changes to every place using this list. Quantities changed on a
+              single place are left as they are.
+            </DialogDescription>
+          </DialogHeader>
+
+          {draft && (
+            <div className="space-y-4">
+              <div className="space-y-2">
+                <Label htmlFor="sl-name">Name</Label>
+                <Input
+                  id="sl-name"
+                  value={draft.name}
+                  placeholder="Standard two-bedroom"
+                  onChange={(e) => setDraft({ ...draft, name: e.target.value })}
+                />
+              </div>
+
+              <div className="space-y-2">
+                <Label>Items</Label>
+                {draft.items.map((item, index) => (
+                  <div key={index} className="flex flex-wrap items-center gap-2">
+                    <Input
+                      className="min-w-40 flex-1"
+                      value={item.name}
+                      placeholder="Bath towel"
+                      onChange={(e) => {
+                        const items = [...draft.items];
+                        items[index] = { ...item, name: e.target.value };
+                        setDraft({ ...draft, items });
+                      }}
+                    />
+                    <Input
+                      className="w-20"
+                      type="number"
+                      min={0}
+                      max={999}
+                      value={item.expectedQty}
+                      onChange={(e) => {
+                        const items = [...draft.items];
+                        items[index] = { ...item, expectedQty: Number(e.target.value) || 0 };
+                        setDraft({ ...draft, items });
+                      }}
+                    />
+                    <Input
+                      className="w-24"
+                      value={item.unit ?? ""}
+                      placeholder="unit"
+                      onChange={(e) => {
+                        const items = [...draft.items];
+                        items[index] = { ...item, unit: e.target.value || null };
+                        setDraft({ ...draft, items });
+                      }}
+                    />
+                    <Button
+                      type="button"
+                      size="sm"
+                      variant="ghost"
+                      onClick={() =>
+                        setDraft({ ...draft, items: draft.items.filter((_, i) => i !== index) })
+                      }
+                    >
+                      ✕
+                    </Button>
+                  </div>
+                ))}
+                <Button
+                  type="button"
+                  size="sm"
+                  variant="outline"
+                  onClick={() =>
+                    setDraft({
+                      ...draft,
+                      items: [...draft.items, { name: "", expectedQty: 1, unit: null }],
+                    })
+                  }
+                >
+                  ➕ Add item
+                </Button>
+              </div>
+
+              <Button
+                className="w-full"
+                disabled={!draft.name.trim() || save.isPending}
+                onClick={() => save.mutate(draft)}
+              >
+                {save.isPending ? "Saving…" : "Save supply list"}
+              </Button>
+            </div>
+          )}
+        </DialogContent>
+      </Dialog>
+    </AppShell>
+  );
+}
