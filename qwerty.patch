+    if (!property || !property.active) return null;
+
+    const { data: org } = await db
+      .from("organizations")
+      .select("id, name")
+      .eq("id", property.org_id)
+      .maybeSingle();
+    if (!org) return null;
+
+    return {
+      orgName: org.name,
+      propertyId: property.id,
+      propertyName: property.name,
+      unitLabel: property.unit_label,
+      city: property.city,
